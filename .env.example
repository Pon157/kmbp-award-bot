# Скопируйте в .env и заполните. Строки с # — комментарии.

# ── Обязательное ──────────────────────────────────────────────
BOT_TOKEN=123456789:AA...                 # токен бота от @BotFather
OWNER_IDS=123456789,987654321             # Telegram-id владельцев (через запятую) — у них есть админ-панель
APP_URL=https://bot.example.com/          # публичный HTTPS-адрес ЭТОГО сервера (на него откроется мини-апп)

# ── Прокси для api.telegram.org (если Telegram с сервера недоступен) ──
# TG_PROXY=socks5://user:pass@1.2.3.4:1080     # SOCKS5 (socks5h:// — DNS на стороне прокси), socks4:// тоже можно
# TG_PROXY=http://user:pass@1.2.3.4:3128       # HTTP(S)-прокси (CONNECT)
# Спецсимволы в логине/пароле кодируйте: @ → %40, : → %3A, / → %2F, % → %25
# Либо зеркало API вместо прокси (свой reverse-proxy к api.telegram.org):
# TG_API_BASE=https://tg-mirror.example.com

# ── Необязательное ────────────────────────────────────────────
PORT=3000                                 # порт мини-аппа и API
HOST=0.0.0.0
DB_PATH=./data/bot.sqlite                 # файл базы (в Docker — /data/bot.sqlite)
UPDATES=polling                           # polling (по умолчанию, работает за NAT) или webhook (нужен публичный HTTPS)
# WEBHOOK_URL=https://bot.example.com     # для UPDATES=webhook; по умолчанию берётся из APP_URL
API_RATE_PER_MIN=240                      # лимит запросов мини-аппа на одного пользователя в минуту
LOG_LEVEL=info                            # error | warn | info | debug
