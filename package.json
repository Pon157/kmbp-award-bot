    "export": "node --no-warnings --import ./server/register.mjs server/cli.mjs export"
  },
  "devDependencies": {
    "@tgcloud/cli": "^0.2.0"
  },
  "type": "module",
  "dependencies": {
    "undici": "^7.0.0",
    "fetch-socks": "^1.3.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}